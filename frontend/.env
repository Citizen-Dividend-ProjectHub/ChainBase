# MetaMask Embedded Wallets (Web3Auth) — Custom JWT connection.
# Fill in the Client ID from the dashboard project (safe to be public/frontend-visible).
VITE_WEB3AUTH_CLIENT_ID=BF003JrZvtqH0vxlifP6_s8Dznqi8N_kB-BObjhvxOD6ATx7ze--W-rGpWsnJyNxNxQNjdv5-sLaaisp8J-c8dc
VITE_WEB3AUTH_AUTH_CONNECTION_ID=chainbase-recipients-v2
# sapphire_devnet for development; switch to sapphire_mainnet for production.
# This is Web3Auth's own MPC infrastructure network — unrelated to which Ethereum
# network disbursements actually run on.
VITE_WEB3AUTH_NETWORK=sapphire_devnet
